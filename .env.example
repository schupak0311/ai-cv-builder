# Required: your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional. The values below are the defaults.
# real calls Claude; fake uses a built-in model that needs no key.
# LLM_MODE=real
# CV_MODEL=claude-opus-5-5
# low, medium or high.
# CV_EFFORT=medium
# How long the fake model takes per job, in milliseconds.
# FAKE_LLM_DELAY_MS=3000
# The port the app is served on, http://localhost:8080 by default.
# PORT=8080
